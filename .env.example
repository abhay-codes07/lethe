# Copy to .env and fill in. Never commit .env.

# --- Agent runtime -----------------------------------------------------------
# Base URL of the self-hosted TrueForge harness Lethe drives.
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_API_KEY=

# Sandbox provider used for shadow-snapshot simulation.
DAYTONA_API_KEY=

# --- Connected systems (read-only creds for discovery) -----------------------
# Discovery must never be given write credentials. See src/agents/scout.ts.
PGURL_READONLY=postgres://lethe_ro@localhost:5432/app

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Test-mode key only. Lethe is never pointed at live payment data in development.
STRIPE_API_KEY=sk_test_

VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=

# --- Execution (write creds, used only behind an approved plan) --------------
PGURL_WRITE=
